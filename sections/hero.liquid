<img src="{{ 'placeholder.svg' | asset_url }}" loading="eager" alt="" class="header_background-image header_background-image--desktop">
{% endif %}{% if section.settings.custom_mobile_media and section.settings.media_type_1_mobile == 'image' %}    <div li-if="section.settings.custom_mobile_media and section.settings.media_type_1_mobile == 'image'">
    {% if section.settings.image_image_1_mobile %}
{{ section.settings.image_image_1_mobile | image_url: width: 750 | image_tag: loading: 'eager', class: 'header_background-image header_background-image--mobile' }}
{% else %}
<img src="{{ 'placeholder.svg' | asset_url }}" loading="eager" alt="" class="header_background-image header_background-image--mobile">
{% endif %}    </div>
{% endif %}</div>    </div>
