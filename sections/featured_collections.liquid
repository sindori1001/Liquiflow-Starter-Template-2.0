<div class="padding-global padding-section-medium" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; --collection-columns: {{ section.settings.columns }};"><div class="container-large"><div class="max-width-large"><h2 class="heading-style-h2">
{{ section.settings.text_heading }}
</h2></div><div class="spacer-medium"></div><div class="more_component"><div class="more_list-wrapper"><div li-content-for-theme-blocks="" role="list" class="more_liste">
{% content_for 'blocks' %}
</div><div class="hide"><div>No items found.</div></div></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Featured collections",
    "class": "section_mehr",
    "blocks": [
        {
            "type": "block"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Short heading here"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "header",
            "content": "Layout"
        },
        {
            "type": "range",
            "id": "columns",
            "min": 2,
            "max": 4,
            "step": 1,
            "label": "Kollektionen pro Reihe",
            "default": 3
        }
    ],
    "presets": [
        {
            "name": "Featured collections",
            "category": "Liquify",
            "blocks": [
                {
                    "type": "block"
                }
            ]
        }
    ]
} {% endschema %}