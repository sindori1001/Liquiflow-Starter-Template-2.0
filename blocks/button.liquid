<div li-block="Button" class="button-group" {{ block.shopify_attributes }}>
                    <div style="{% if block.settings.style_class == 'button-custom' %}--btn-bg: {{ block.settings.custom_button_background }}; --btn-text: {{ block.settings.custom_button_text }}; --btn-border: {{ block.settings.custom_button_border }}; {% elsif block.settings.style_class == 'button-unstyled' and block.settings.link_text_color != blank %}--btn-text: {{ block.settings.link_text_color }}; {% endif %}--btn-width: {% if block.settings.width == 'custom' %}{{ block.settings.custom_width }}%{% else %}fit-content{% endif %};"><a href="{{ block.settings.url_button_link }}" class="size-style {% case block.settings.style_class %}{% when 'button-secondary' %}button is-secondary{% when 'button-unstyled' %}button is-link{% else %}button{% endcase %}"> {{ block.settings.text_button_text }} </a></div>
                    
                </div> {% schema %} {
    "name": "Button",
    "settings": [
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button-Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button-Text",
            "default": "More Information"
        },
        {
            "type": "header",
            "content": "Style"
        },
        {
            "type": "select",
            "id": "style_class",
            "label": "Style",
            "options": [
                {
                    "value": "button",
                    "label": "Primary"
                },
                {
                    "value": "button-secondary",
                    "label": "Secondary"
                },
                {
                    "value": "button-unstyled",
                    "label": "Link"
                },
                {
                    "value": "button-custom",
                    "label": "Custom"
                }
            ],
            "default": "button"
        },
        {
            "type": "color_background",
            "id": "custom_button_background",
            "label": "Background color",
            "default": "{{ settings.colors.primary }}",
            "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
        },
        {
            "type": "color",
            "id": "custom_button_text",
            "label": "Text color",
            "default": "{{ settings.colors.background }}",
            "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
        },
        {
            "type": "color",
            "id": "custom_button_border",
            "label": "Border color",
            "default": "{{ settings.colors.primary }}",
            "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
        },
        {
            "type": "color",
            "id": "link_text_color",
            "label": "Link text color",
            "default": "{{ settings.colors.primary }}",
            "visible_if": "{{ block.settings.style_class == 'button-unstyled' }}"
        },
        {
            "type": "checkbox",
            "id": "open_in_new_tab",
            "label": "Open in new tab",
            "default": false
        },
        {
            "type": "select",
            "id": "width",
            "label": "Width",
            "options": [
                {
                    "value": "fit-content",
                    "label": "Fit content"
                },
                {
                    "value": "custom",
                    "label": "Custom"
                }
            ],
            "default": "fit-content"
        },
        {
            "type": "range",
            "id": "custom_width",
            "min": 10,
            "max": 100,
            "step": 5,
            "unit": "%",
            "label": "Custom width (when Width = Custom)",
            "default": 100,
            "visible_if": "{{ block.settings.width == 'custom' }}"
        },
        {
            "type": "select",
            "id": "width_mobile",
            "label": "Width (mobile)",
            "options": [
                {
                    "value": "fit-content",
                    "label": "Fit content"
                },
                {
                    "value": "custom",
                    "label": "Custom"
                }
            ],
            "default": "fit-content"
        },
        {
            "type": "range",
            "id": "custom_width_mobile",
            "min": 10,
            "max": 100,
            "step": 5,
            "unit": "%",
            "label": "Custom width mobile (when Width mobile = Custom)",
            "default": 100,
            "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
        }
    ],
    "presets": [
        {
            "name": "Button",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}