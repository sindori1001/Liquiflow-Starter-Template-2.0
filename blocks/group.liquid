<div li-block="Group" {{ block.shopify_attributes }}>
                    <div class="hero_group" style="--group-direction: {{ block.settings.content_direction }}; --group-mobile-column: {% if block.settings.vertical_on_mobile %}1{% else %}0{% endif %}; --group-justify: {% if block.settings.content_direction == 'row' %}{{ block.settings.horizontal_alignment }}{% else %}{{ block.settings.horizontal_alignment_flex_direction_column }}{% endif %}; --group-align: {% if block.settings.align_baseline %}baseline{% elsif block.settings.content_direction == 'row' %}{{ block.settings.vertical_alignment }}{% else %}{{ block.settings.vertical_alignment_flex_direction_column }}{% endif %}; --group-gap: {{ block.settings.gap }}px; --group-width: {% if block.settings.width == 'fill' %}100%{% elsif block.settings.width == 'custom' %}{{ block.settings.custom_width }}%{% else %}fit-content{% endif %}; --group-height: {% if block.settings.height == 'fill' %}100%{% elsif block.settings.height == 'custom' %}{{ block.settings.custom_height }}%{% else %}fit-content{% endif %}; --group-bg: {% if block.settings.background_media == 'none' %}{{ block.settings.background_color }}{% else %}transparent{% endif %}; --group-radius: {{ block.settings.border_radius }}px; --group-border-style: {{ block.settings.border }}; --group-border-width: {{ block.settings.border_width }}px; --group-border-color: {{ block.settings.border_color }}; --group-border-opacity: {{ block.settings.border_opacity }}%; --group-padding: {{ block.settings['padding-block-start'] }}px {{ block.settings['padding-inline-end'] }}px {{ block.settings['padding-block-end'] }}px {{ block.settings['padding-inline-start'] }}px;">{% if block.settings.link != blank %}    <div li-if="block.settings.link != blank">
    <a href="{{ block.settings.url_group_link }}" class="hero_group-link"> </a>    </div>
{% endif %}{% if block.settings.background_media == 'image' and block.settings.image_group_background != blank %}    <div li-if="block.settings.background_media == 'image' and block.settings.image_group_background != blank" class="hero_group-media">
    {% if block.settings.image_group_background %}
{{ block.settings.image_group_background | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'hero_group-media-img' }}
{% else %}
<img src="{{ 'placeholder.svg' | asset_url }}" loading="lazy" alt="" class="hero_group-media-img">
{% endif %}    </div>
{% endif %}{% if block.settings.toggle_overlay %}    <div li-if="block.settings.toggle_overlay">
    <div class="hero_group-overlay" style="background: {% if block.settings.overlay_style == 'gradient' %}linear-gradient({{ block.settings.gradient_direction }}, transparent, {{ block.settings.overlay_color }}){% else %}{{ block.settings.overlay_color }}{% endif %};"></div>    </div>
{% endif %}<div class="hero_group-blocks" li-cf-theme-blocks="theme">
{% content_for 'blocks' %}
</div></div>
                    
                </div> {% schema %} {
    "name": "Group",
    "blocks": [
        {
            "type": "@theme"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "url_group_link",
            "type": "url",
            "label": "Group-Link"
        },
        {
            "id": "image_group_background",
            "type": "image_picker",
            "label": "Group Background"
        },
        {
            "type": "header",
            "content": "Style"
        },
        {
            "type": "select",
            "id": "content_direction",
            "label": "Direction",
            "options": [
                {
                    "value": "row",
                    "label": "Row"
                },
                {
                    "value": "column",
                    "label": "Column"
                }
            ],
            "default": "row"
        },
        {
            "type": "checkbox",
            "id": "vertical_on_mobile",
            "label": "Stack vertically on mobile",
            "default": true,
            "visible_if": "{{ block.settings.content_direction == 'row' }}"
        },
        {
            "type": "select",
            "id": "horizontal_alignment",
            "label": "Horizontal alignment",
            "options": [
                {
                    "value": "flex-start",
                    "label": "Left"
                },
                {
                    "value": "center",
                    "label": "Center"
                },
                {
                    "value": "flex-end",
                    "label": "Right"
                },
                {
                    "value": "space-between",
                    "label": "Space between"
                }
            ],
            "default": "flex-start",
            "visible_if": "{{ block.settings.content_direction == 'row' }}"
        },
        {
            "type": "select",
            "id": "vertical_alignment",
            "label": "Vertical alignment",
            "options": [
                {
                    "value": "flex-start",
                    "label": "Top"
                },
                {
                    "value": "center",
                    "label": "Center"
                },
                {
                    "value": "flex-end",
                    "label": "Bottom"
                }
            ],
            "default": "center",
            "visible_if": "{{ block.settings.content_direction == 'row' }}"
        },
        {
            "type": "checkbox",
            "id": "align_baseline",
            "label": "Align content to text baseline",
            "default": false,
            "visible_if": "{{ block.settings.vertical_alignment == 'flex-end' }}"
        },
        {
            "type": "select",
            "id": "horizontal_alignment_flex_direction_column",
            "label": "Horizontal alignment",
            "options": [
                {
                    "value": "flex-start",
                    "label": "Left"
                },
                {
                    "value": "center",
                    "label": "Center"
                },
                {
                    "value": "flex-end",
                    "label": "Right"
                }
            ],
            "default": "flex-start",
            "visible_if": "{{ block.settings.content_direction != 'row' }}"
        },
        {
            "type": "select",
            "id": "vertical_alignment_flex_direction_column",
            "label": "Vertical alignment",
            "options": [
                {
                    "value": "flex-start",
                    "label": "Top"
                },
                {
                    "value": "center",
                    "label": "Center"
                },
                {
                    "value": "flex-end",
                    "label": "Bottom"
                },
                {
                    "value": "space-between",
                    "label": "Space between"
                }
            ],
            "default": "center",
            "visible_if": "{{ block.settings.content_direction == 'column' }}"
        },
        {
            "type": "range",
            "id": "gap",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Gap",
            "default": 16
        },
        {
            "type": "select",
            "id": "width",
            "label": "Width",
            "options": [
                {
                    "value": "fit-content",
                    "label": "Fit content"
                },
                {
                    "value": "fill",
                    "label": "Fill"
                },
                {
                    "value": "custom",
                    "label": "Custom"
                }
            ],
            "default": "fill"
        },
        {
            "type": "range",
            "id": "custom_width",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "%",
            "label": "Custom width",
            "default": 100,
            "visible_if": "{{ block.settings.width == 'custom' }}"
        },
        {
            "type": "select",
            "id": "width_mobile",
            "label": "Width (mobile)",
            "options": [
                {
                    "value": "fit-content",
                    "label": "Fit content"
                },
                {
                    "value": "fill",
                    "label": "Fill"
                },
                {
                    "value": "custom",
                    "label": "Custom"
                }
            ],
            "default": "fill"
        },
        {
            "type": "range",
            "id": "custom_width_mobile",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "%",
            "label": "Custom width (mobile)",
            "default": 100,
            "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
        },
        {
            "type": "select",
            "id": "height",
            "label": "Height",
            "options": [
                {
                    "value": "fit",
                    "label": "Fit content"
                },
                {
                    "value": "fill",
                    "label": "Fill"
                },
                {
                    "value": "custom",
                    "label": "Custom"
                }
            ],
            "default": "fit"
        },
        {
            "type": "range",
            "id": "custom_height",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "%",
            "label": "Custom height",
            "default": 100,
            "visible_if": "{{ block.settings.height == 'custom' }}"
        },
        {
            "type": "select",
            "id": "background_media",
            "label": "Background",
            "options": [
                {
                    "value": "none",
                    "label": "None"
                },
                {
                    "value": "image",
                    "label": "Image"
                }
            ],
            "default": "none"
        },
        {
            "type": "color_background",
            "id": "background_color",
            "label": "Background color",
            "default": "{{ settings.colors.background }}",
            "visible_if": "{{ block.settings.background_media == 'none' }}"
        },
        {
            "type": "select",
            "id": "background_image_position",
            "label": "Image fit",
            "options": [
                {
                    "value": "cover",
                    "label": "Cover"
                },
                {
                    "value": "fit",
                    "label": "Fit"
                }
            ],
            "default": "cover",
            "visible_if": "{{ block.settings.background_media == 'image' }}"
        },
        {
            "type": "checkbox",
            "id": "toggle_overlay",
            "label": "Show overlay",
            "default": false
        },
        {
            "type": "color",
            "id": "overlay_color",
            "label": "Overlay color",
            "alpha": true,
            "default": "{{ settings.colors.text }}",
            "visible_if": "{{ block.settings.toggle_overlay }}"
        },
        {
            "type": "select",
            "id": "overlay_style",
            "label": "Overlay style",
            "options": [
                {
                    "value": "solid",
                    "label": "Solid"
                },
                {
                    "value": "gradient",
                    "label": "Gradient"
                }
            ],
            "default": "solid",
            "visible_if": "{{ block.settings.toggle_overlay }}"
        },
        {
            "type": "select",
            "id": "gradient_direction",
            "label": "Gradient direction",
            "options": [
                {
                    "value": "to top",
                    "label": "Up"
                },
                {
                    "value": "to bottom",
                    "label": "Down"
                }
            ],
            "default": "to top",
            "visible_if": "{{ block.settings.toggle_overlay and block.settings.overlay_style == 'gradient' }}"
        },
        {
            "type": "select",
            "id": "border",
            "label": "Border style",
            "options": [
                {
                    "value": "none",
                    "label": "None"
                },
                {
                    "value": "solid",
                    "label": "Solid"
                }
            ],
            "default": "none"
        },
        {
            "type": "range",
            "id": "border_width",
            "min": 0,
            "max": 20,
            "step": 1,
            "unit": "px",
            "label": "Border thickness",
            "default": 1,
            "visible_if": "{{ block.settings.border != 'none' }}"
        },
        {
            "type": "range",
            "id": "border_opacity",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "%",
            "label": "Border opacity",
            "default": 100,
            "visible_if": "{{ block.settings.border != 'none' }}"
        },
        {
            "type": "color",
            "id": "border_color",
            "label": "Border color",
            "default": "{{ settings.colors.primary }}",
            "visible_if": "{{ block.settings.border != 'none' }}"
        },
        {
            "type": "range",
            "id": "border_radius",
            "label": "Corner radius",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 0
        },
        {
            "type": "url",
            "id": "link",
            "label": "Link entire group to"
        },
        {
            "type": "checkbox",
            "id": "open_in_new_tab",
            "label": "Open in new tab",
            "default": false
        },
        {
            "type": "range",
            "id": "padding-block-start",
            "min": 0,
            "max": 100,
            "step": 2,
            "unit": "px",
            "label": "Padding top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding-block-end",
            "min": 0,
            "max": 100,
            "step": 2,
            "unit": "px",
            "label": "Padding bottom",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding-inline-start",
            "min": 0,
            "max": 100,
            "step": 2,
            "unit": "px",
            "label": "Padding left",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding-inline-end",
            "min": 0,
            "max": 100,
            "step": 2,
            "unit": "px",
            "label": "Padding right",
            "default": 0
        }
    ],
    "presets": [
        {
            "name": "Group",
            "blocks": [
                {
                    "type": "@theme"
                }
            ]
        }
    ],
    "tag": null
} {% endschema %}