<div li-block="Heading" {{ block.shopify_attributes }}>
                    <div class="heading_text" style="color: {{ block.settings.text_color }}; text-align: {{ block.settings.alignment }};">{% render 'heading' %}</div>
                    
                </div> {% schema %} {
    "name": "Heading",
    "settings": [
        {
            "type": "header",
            "content": "Style"
        },
        {
            "type": "richtext",
            "id": "text",
            "label": "Heading text",
            "default": "New arrivals"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Text color",
            "default": "{{ settings.colors.text }}"
        },
        {
            "type": "text_alignment",
            "id": "alignment",
            "label": "Alignment",
            "default": "left"
        }
    ],
    "presets": [
        {
            "name": "Heading",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}